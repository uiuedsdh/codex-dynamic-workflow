{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/uiuedsdh/codex-dynamic-workflow/main/schemas/workflow.schema.json",
  "title": "Codex Dynamic Workflow definition",
  "type": "object",
  "required": ["api_version", "name", "description", "execution", "nodes"],
  "additionalProperties": false,
  "properties": {
    "api_version": {"const": "codex.workflow/v1"},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$|^[a-z0-9]$"},
    "description": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/input"},
      "default": {}
    },
    "execution": {"$ref": "#/$defs/execution"},
    "result": {"$ref": "#/$defs/result"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/node"}
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["string", "integer", "number", "boolean", "array", "object"]},
        "required": {"type": "boolean", "default": false},
        "default": {},
        "description": {"type": "string"}
      }
    },
    "execution": {
      "type": "object",
      "required": ["failure_policy"],
      "additionalProperties": false,
      "properties": {
        "failure_policy": {"enum": ["fail_fast", "continue_independent"]},
        "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 32, "default": 4},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "max_agent_calls": {"type": "integer", "minimum": 1}
      }
    },
    "result": {
      "type": "object",
      "required": ["outputs"],
      "additionalProperties": false,
      "properties": {
        "outputs": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10, "default": 1},
        "delay_seconds": {"type": "number", "minimum": 0, "default": 0}
      }
    },
    "baseNode": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"},
        "type": {"type": "string"},
        "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "retry": {"$ref": "#/$defs/retry"},
        "when": {"$ref": "#/$defs/condition"}
      }
    },
    "agent": {
      "allOf": [
        {"$ref": "#/$defs/baseNode"},
        {
          "type": "object",
          "required": ["id", "type", "prompt"],
          "additionalProperties": false,
          "properties": {
            "id": true, "type": {"const": "agent"}, "depends_on": true, "timeout_seconds": true,
            "retry": true, "when": true,
            "prompt": {"type": "string", "minLength": 1},
            "output_schema": {"type": "string"},
            "sandbox": {"enum": ["read-only", "workspace-write"], "default": "read-only"},
            "model": {"type": "string"},
            "lane": {"type": "string"}
          }
        }
      ]
    },
    "command": {
      "allOf": [
        {"$ref": "#/$defs/baseNode"},
        {
          "type": "object",
          "required": ["id", "type", "command"],
          "additionalProperties": false,
          "properties": {
            "id": true, "type": {"const": "command"}, "depends_on": true, "timeout_seconds": true,
            "retry": true, "when": true,
            "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "lane": {"type": "string"},
            "writes": {"type": "boolean", "default": false},
            "capture_json": {"type": "boolean", "default": false}
          }
        }
      ]
    },
    "barrier": {
      "allOf": [
        {"$ref": "#/$defs/baseNode"},
        {
          "type": "object",
          "required": ["id", "type", "depends_on", "policy"],
          "additionalProperties": false,
          "properties": {
            "id": true, "type": {"const": "barrier"}, "depends_on": true, "timeout_seconds": true,
            "retry": true, "when": true,
            "policy": {
              "type": "object",
              "required": ["mode"],
              "additionalProperties": false,
              "properties": {
                "mode": {"enum": ["all_success", "all_terminal", "minimum_success"]},
                "count": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      ]
    },
    "foreach": {
      "allOf": [
        {"$ref": "#/$defs/baseNode"},
        {
          "type": "object",
          "required": ["id", "type", "items", "template", "max_items"],
          "additionalProperties": false,
          "properties": {
            "id": true, "type": {"const": "foreach"}, "depends_on": true, "timeout_seconds": true,
            "retry": true, "when": true,
            "items": {"type": "string"},
            "template": {"oneOf": [{"$ref": "#/$defs/agentTemplate"}, {"$ref": "#/$defs/commandTemplate"}, {"$ref": "#/$defs/loopTemplate"}]},
            "max_items": {"type": "integer", "minimum": 0, "maximum": 1000}
          }
        }
      ]
    },
    "loop": {
      "allOf": [
        {"$ref": "#/$defs/baseNode"},
        {
          "type": "object",
          "required": ["id", "type", "max_iterations", "on_exhausted", "body", "until"],
          "additionalProperties": false,
          "properties": {
            "id": true, "type": {"const": "loop"}, "depends_on": true, "timeout_seconds": true,
            "retry": true, "when": true,
            "max_iterations": {"type": "integer", "minimum": 1, "maximum": 100},
            "on_exhausted": {"enum": ["fail", "continue_partial"]},
            "body": {
              "type": "array", "minItems": 1,
              "items": {"oneOf": [{"$ref": "#/$defs/agentTemplate"}, {"$ref": "#/$defs/commandTemplate"}]}
            },
            "until": {"$ref": "#/$defs/condition"}
          }
        }
      ]
    },
    "merge": {
      "allOf": [
        {"$ref": "#/$defs/baseNode"},
        {
          "type": "object",
          "required": ["id", "type", "depends_on", "output"],
          "additionalProperties": false,
          "anyOf": [{"required": ["lanes"]}, {"required": ["lane_groups"]}],
          "properties": {
            "id": true, "type": {"const": "merge"}, "depends_on": true, "timeout_seconds": true,
            "retry": true, "when": true,
            "lanes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
            "lane_groups": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
            "output": {
              "type": "object", "required": ["mode"], "additionalProperties": false,
              "properties": {"mode": {"enum": ["patch", "branch", "source"]}, "path": {"type": "string"}}
            },
            "verify_command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "conflict_prompt": {"type": "string"}
          }
        }
      ]
    },
    "agentTemplate": {
      "type": "object",
      "required": ["type", "prompt"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"}, "type": {"const": "agent"}, "prompt": {"type": "string"},
        "output_schema": {"type": "string"}, "sandbox": {"enum": ["read-only", "workspace-write"]},
        "model": {"type": "string"}, "lane": {"type": "string"}, "timeout_seconds": {"type": "integer", "minimum": 1},
        "retry": {"$ref": "#/$defs/retry"}, "when": {"$ref": "#/$defs/condition"}
      }
    },
    "commandTemplate": {
      "type": "object",
      "required": ["type", "command"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"}, "type": {"const": "command"},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "lane": {"type": "string"}, "writes": {"type": "boolean"}, "capture_json": {"type": "boolean"},
        "timeout_seconds": {"type": "integer", "minimum": 1}, "retry": {"$ref": "#/$defs/retry"},
        "when": {"$ref": "#/$defs/condition"}
      }
    },
    "loopTemplate": {
      "type": "object",
      "required": ["type", "max_iterations", "on_exhausted", "body", "until"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"}, "type": {"const": "loop"},
        "max_iterations": {"type": "integer", "minimum": 1, "maximum": 100},
        "on_exhausted": {"enum": ["fail", "continue_partial"]},
        "body": {
          "type": "array", "minItems": 1,
          "items": {"oneOf": [{"$ref": "#/$defs/agentTemplate"}, {"$ref": "#/$defs/commandTemplate"}]}
        },
        "until": {"$ref": "#/$defs/condition"},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "retry": {"$ref": "#/$defs/retry"}, "when": {"$ref": "#/$defs/condition"}
      }
    },
    "condition": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string"},
        "field": {"type": "string"},
        "equals": {},
        "exit_code": {"type": "integer"}
      },
      "oneOf": [{"required": ["field", "equals"]}, {"required": ["exit_code"]}]
    },
    "node": {
      "oneOf": [
        {"$ref": "#/$defs/agent"}, {"$ref": "#/$defs/command"}, {"$ref": "#/$defs/barrier"},
        {"$ref": "#/$defs/foreach"}, {"$ref": "#/$defs/loop"}, {"$ref": "#/$defs/merge"}
      ]
    }
  }
}
